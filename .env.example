# Окружение: dev | prod | test
APP_ENV=dev
# Строка подключения к PostgreSQL (asyncpg и Alembic используют одну и ту же)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/interviewhub
# Секрет для подписи JWT — в продакшене сгенерируйте: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
# Разрешённые источники для CORS (JSON-массив)
ALLOWED_HOSTS=["*"]
